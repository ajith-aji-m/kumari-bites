{
  "name": "kumari-bites",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch src/server/server.ts",
    "build": "tsc -p tsconfig.json && vite build",
    "start": "node dist/server/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "seed": "tsx src/db/seed.ts",
    "test": "node --import tsx --import ./test/setup.ts --test 'test/**/*.test.ts'"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/websocket": "^11.3.1",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "mysql2": "^3.24.5",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.1.9"
  }
}
