NODE_ENV=development
HOST=127.0.0.1
PORT=4000
DATABASE_URL=mysql://root:password@127.0.0.1:3306/kumari_bites
CORS_ORIGIN=http://localhost:5173

# Initial admin seed credentials — change these before production.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@kumaribites.local
ADMIN_PHONE=
ADMIN_PASSWORD=ChangeMe123!
# ---- WhatsApp AI assistant ----
# Required to save AI API keys and link WhatsApp. 32 random bytes, base64 or hex:
#   openssl rand -base64 32
# Keep it secret and stable: changing it makes stored keys and the WhatsApp session unreadable
# (you would re-enter the API key and scan the QR code again).
APP_ENCRYPTION_KEY=
# Reconnect the linked WhatsApp session automatically when the server starts (true/false).
WHATSAPP_AUTO_RESTORE=true
# Optional: folder containing assets/menu/... if menu images are served from somewhere other than ./public or ./dist/client.
PUBLIC_ASSETS_DIR=
